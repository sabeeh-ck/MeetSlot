{
    "compilerOptions": {
        "module": "nodenext",
        "target": "es2022",
        "moduleResolution": "nodenext",
        "types": ["node"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "noEmit": true
    },
    "include": ["**/*.ts"]
}
