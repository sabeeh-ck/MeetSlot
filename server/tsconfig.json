{
    "compilerOptions": {
        "module": "nodenext",
        "target": "es2022",
        "moduleResolution": "nodenext",
        "types": ["node"],
        "strict": true,
        "esModuleInterop": true,
        "skipLibCheck": true,
        "forceConsistentCasingInFileNames": true,
        "rootDir": ".",
        "outDir": "dist"
    },
    "include": ["**/*.ts"],
    "exclude": ["node_modules", "dist"]
}
